DEBUG=False

# 파싱 결과 저장 디렉터리 (기본: ./data)
DATA_DIR=data

# TUK World 쓰기 API 보호 (비어 있으면 쓰기 전부 거부)
# KC_SERVER_URL은 토큰 iss와 같은 공개 Keycloak 주소(끝의 /auth/ 포함)
KC_SERVER_URL=
KC_REALM=Sandori
KC_ADMIN_ROLE=global_admin
# 컨테이너에서 공개 주소로 JWKS를 못 받을 때 내부 주소로 지정
# 예: http://keycloak:8080/auth/realms/Sandori/protocol/openid-connect/certs
KC_JWKS_URL=
# TUK World DB·이미지 저장 디렉터리 (기본: DATA_DIR/tuk_world), 업로드 최대 바이트
# TUK_WORLD_DIR=
# TUK_WORLD_MAX_IMAGE_BYTES=5242880
