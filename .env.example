DEBUG=False

# 파싱 결과 저장 디렉터리 (기본: ./data)
DATA_DIR=data

# TUK World 쓰기 API 보호 (비어 있으면 쓰기 전부 거부)
# KC_SERVER_URL은 토큰 iss와 같은 공개 Keycloak 주소(끝의 /auth/ 포함)
KC_SERVER_URL=
KC_REALM=Sandori
KC_ADMIN_ROLE=global_admin
# 셔틀 시간표 쓰기(관리자 API·PUT/DELETE/refresh)를 허용하는 realm 롤, 쉼표 구분
SHUTTLE_ADMIN_ROLES=global_admin,shuttle_admin
# 컨테이너에서 공개 주소로 JWKS를 못 받을 때 내부 주소로 지정
# 예: http://keycloak:8080/auth/realms/Sandori/protocol/openid-connect/certs
KC_JWKS_URL=
# 쉼표 구분. 설정하면 토큰의 azp/aud 중 하나가 목록에 있어야 통과 (비어 있으면 검사 안 함)
# 예: KC_ALLOWED_CLIENTS=kakao-bot,meal-web
KC_ALLOWED_CLIENTS=
# 응답 이미지 URL을 절대 주소로 만들 공개 도메인 (비어 있으면 상대경로)
# 예: PUBLIC_BASE_URL=https://sandori.kr
PUBLIC_BASE_URL=
# TUK World DB·이미지 저장 디렉터리 (기본: DATA_DIR/tuk_world), 업로드 최대 바이트
# TUK_WORLD_DIR=
# TUK_WORLD_MAX_IMAGE_BYTES=5242880

# 관리자 화면(/static-info/admin). 아래가 하나라도 비면 마운트하지 않는다(fail-closed).
# KC_SERVER_URL·KC_REALM·KC_ADMIN_ROLE·KC_JWKS_URL은 위 값을 같이 쓴다.
ADMIN_PANEL_ENABLED=False
# static-info 전용 confidential client. redirect URI: {STATIC_INFO_PUBLIC_BASE_URL}/admin-oauth/callback
KC_CLIENT_ID=
KC_CLIENT_SECRET=
# 예: https://sandori.kr/static-info
STATIC_INFO_PUBLIC_BASE_URL=
# Fernet 키: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_SESSION_KEY=
# ADMIN_SESSION_TTL_SECONDS=3600
# 컨테이너에서 공개 주소로 토큰 교환이 안 될 때 내부 주소로 지정
# 예: http://keycloak:8080/auth/realms/Sandori/protocol/openid-connect/token
KC_TOKEN_URL=
# 조직도 원본 경로 (기본: app/config/school_info.json). 편집하려면 디렉터리를 rw 마운트
# SCHOOL_INFO_PATH=
