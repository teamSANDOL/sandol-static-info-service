DEBUG=False

# Static Info 셔틀 시간표 관리 API 인증. 원본이 아니라 SHA-256 해시값.
# 루트 저장소의 python scripts/generate_secrets.py 가 출력하는 값을 붙여넣고, 원본 키는 따로 보관하세요.
STATIC_INFO_API_KEY_SHA256=

# 셔틀 시간표 AI 파싱
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
# flex: 저렴하지만 느리고 혼잡 시 429. 급하면 default
OPENAI_SERVICE_TIER=flex
OPENAI_TIMEOUT=900

# 파싱 결과 저장 디렉터리 (기본: ./data)
DATA_DIR=data
